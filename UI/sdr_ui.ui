      <string notr="true">*{font-family: 'Roboto';
font-style: normal;
font-weight: 600;
font-size: 30px;
line-height: 100%;
/* identical to box height, or 34px */

display: flex;
align-items: center;
letter-spacing: -0.01em;

color: #FFFFFF;

text-shadow: 0px 3px 4px rgba(63, 0, 0, 0.5);
}

*[alert=&quot;true&quot;]{
background-image: url(:/Images/images/rf_alert_on.png);
}

*[alert=&quot;false&quot;]{
background-image: url(:/Images/images/rf_alert_off.png);
}</string>
