   <string notr="true">QDialog {
  background-color: #002f00;
  color: #ffffff;
  font-family: 'Roboto';
  border: 2px solid #4CAF50;
  border-radius: 6px;
}

QLabel {
  color: #ffffff;
  font-size: 18px; 
  font-weight: 500;
}

QComboBox {
  background-color: rgba(0, 10, 0, 0.8);
  border: 1px solid #328844;
  color: #ffffff;
  padding: 4px;
  font-size: 18px;
  border-radius: 3px;
  min-width: 150px;
}

QComboBox::drop-down { 
    width: 18px; 
}

QComboBox::down-arrow { 
    width: 14px; 
    height: 14px; 
}

QComboBox QAbstractItemView {
    background-color: #002f00;
    color: #ffffff;
    selection-background-color: #328844;
    font-size: 16px;
}

/* Кнопки */
QPushButton {
  border: 1px solid #328844;
  background-color: rgba(0, 30, 0, 0.8);
  color: #ffffff;
  font-size: 18px;
  padding: 6px 15px;
  border-radius: 4px;
}

QPushButton:hover {
  background-color: #004400;
}

QPushButton:pressed {
  background-color: #4CAF50;
  color: #002509;
}

/* Специфічний стиль для кнопки Паузи, коли вона натиснута (активна) */
QPushButton:checked {
  background-color: #4CAF50;
  color: #002509;
}

/* Чекбокс */
QCheckBox {
    color: #ffffff;
    font-size: 16px;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: rgba(0, 10, 0, 0.8);
    border: 1px solid #328844;
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #4CAF50;
    border: 1px solid #4CAF50;
}

QCheckBox::indicator:hover {
    border: 1px solid #00ff00;
}

/* Контейнер графіка - робимо його схожим на таблицю з прикладу */
QWidget#chartContainer {
  background-color: rgba(0, 10, 0, 0.3);
  border: 1px solid #328844;
  border-radius: 4px;
}
</string>
