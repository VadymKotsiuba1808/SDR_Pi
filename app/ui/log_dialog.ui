   <string notr="true">QDialog {
  background-color: #002f00;
  color: #ffffff;
  font-family: 'Roboto';
  border: 2px solid #4CAF50;
  border-radius: 6px;
}

QLabel {
  color: #ffffff;
  font-size: 18px; 
  font-weight: 500;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit {
  background-color: rgba(0, 10, 0, 0.8);
  border: 1px solid #328844;
  color: #ffffff;
  padding: 4px;
  font-size: 18px;
  border-radius: 3px;
}

QComboBox::down-arrow { width: 16px; height: 16px; padding:2px }
QComboBox QAbstractItemView {
    background-color: #002f00;
    color: #ffffff;
    selection-background-color: #328844;
}

/* Кнопки календаря */
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button, QDateTimeEdit::up-button, QDateTimeEdit::down-button {
 width: 14px; 
 height: 14px; 
 padding:2px 
}

/* Календар */
QCalendarWidget QWidget {
    background-color: #002f00;
    color: white;
}

/* Таблиця */
QTableWidget {
  background-color: rgba(0, 10, 0, 0.3);
  gridline-color: #328844;
  border: 1px solid #328844;
  font-size: 16px;
  color: #fff;
}
QHeaderView::section {
  background-color: #001a05;
  color: #4CAF50;
  padding: 4px;
  border: 1px solid #328844;
  font-weight: bold;
  font-size: 18px;
}

QTableView{
 font-size: 16px;
}

QTableWidget::item{
 font-size: 30px;
}

/* Кнопки */
QPushButton {
  border: 1px solid #328844;
  background-color: rgba(0, 30, 0, 0.8);
  color: #ffffff;
  font-size: 18px;
  padding: 6px 15px;
  border-radius: 4px;
}
QPushButton:pressed {
  background-color: #4CAF50;
  color: #002509;
}

QPushButton#btnApplyFilters {
  background-color: #004400;
  font-weight: bold;
}

/* Фрейм фільтрів */
QFrame#frameFilters {
    background-color: rgba(0, 20, 0, 0.5);
    border-right: 2px solid #328844;
}

/* Групи */
QGroupBox {
    border: 1px solid #328844;
    border-radius: 5px;
    margin-top: 20px;
    font-weight: bold;
    color: #4CAF50;
    font-size:18px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
    font-size:18px;
}

QTabWidget::pane { border: 1px solid #328844; }
QTabBar::tab {
    background: #001a05;
    color: #888;
    padding: 8px 20px;
    border: 1px solid #328844;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    font-size:18px;
}
QTabBar::tab:selected {
    background: #328844;
    color: #fff;
    font-weight: bold;
}

QPushButton#btnClose {
  background-color: #442222;
  border-color: #aa3333;
}
QPushButton#btnClose:pressed {
  background-color: #aa3333;
}
</string>
