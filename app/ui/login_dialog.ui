    color: #fff;
}

QPushButton:pressed{
    border: none;
    background-image: url(:/images/Btn_MainMenu_on.png);
    font-family: 'Roboto';
    font-weight: 500;
    font-size: 24px;
    color: #002509;
}

QPushButton[enabled=&quot;false&quot;]{
