  <property name="styleSheet">
   <string notr="true">/* Головний фон діалогу - такий самий, як у твого MainWindow */
QDialog#LoginDialog {
    background-color: rgba(0, 47, 0, 139);
}

/* Стилізація всіх віджетів, щоб вони відповідали твоїй темі */
QLabel {
    font-family: 'Roboto';
    font-size: 20px;
    color: #FFFFFF;
    background: none;
    border: none;
}

QLineEdit, QComboBox {
    font-family: 'Roboto';
    font-size: 18px;
    color: #FFFFFF;
    background-color: rgba(0, 20, 0, 0.8);
    border: 1px solid #328844;
    padding: 8px;
    border-radius: 4px;
}

QComboBox QAbstractItemView {
    background-color: #002509; /* Темний фон для списку */
    color: #FFFFFF;
    selection-background-color: #328844; /* Зелений при виборі */
    selection-color: #FFFFFF;
}

QCheckBox {
    font-family: 'Roboto';
    font-size: 16px;
    color: #FFFFFF;
    background: none;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 1px solid #328844;
    background-color: rgba(0, 20, 0, 0.8);
    border-radius: 3px;
}

QCheckBox::indicator:checked {
    background-color: #50E37F; /* Яскраво-зелена галочка */
    image: url(:/images/checkbox_checked_icon.png); /* (Опціонально) якщо маєш свою іконку галочки */
}
</string>
