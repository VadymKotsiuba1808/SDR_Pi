}

/* Таблиця */
QTableWidget {
	background-color: rgba(0, 10, 0, 0.6);
	gridline-color: #328844;
	border: 1px solid #328844;
	font-size: 16px;
}
QTableWidget::item {
	padding: 5px;
}
QTableWidget::item:selected {
	background-color: #328844;
	color: #ffffff;
}
QHeaderView::section {
	background-color: #001a05;
	color: #4CAF50;
	padding: 5px;
	border: 1px solid #328844;
	font-weight: bold;
}

/* Кнопки */
QPushButton {
	background-color: rgba(0, 20, 0, 0.8);
	border: 2px solid #328844;
	color: #ffffff;
	font-size: 16px;
	padding: 8px 15px;
	border-radius: 4px;
}
QPushButton:hover {
	background-color: #328844;
	color: #000;
}
QPushButton:pressed {
	background-color: #4CAF50;
}
QPushButton:disabled {
    background-color: rgba(50, 50, 50, 0.5);
    border-color: #555;
    color: #888;
}

QPushButton#btnDelete {
	border-color: #aa3333;
}
QPushButton#btnDelete:hover {
	background-color: #aa3333;
}</string>
