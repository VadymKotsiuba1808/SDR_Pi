  <property name="styleSheet">
   <string notr="true">/* Глобальний стиль вікна */
QDialog {
	background-color: #002f00;
	border: 2px solid #4CAF50;
	border-radius: 6px;
}

QWidget {
	font-family: 'Roboto';
	color: #ffffff;
}

/* Стиль панелі управління */
QFrame#controlPanelFrame {
	background-color: rgba(0, 10, 0, 0.6);
	border: 1px solid #328844;
	border-radius: 4px;
}

/* Стилі написів */
QLabel {
	font-size: 20px;
	background-color: transparent;
	border: none;
}

/* Стилі кнопок (як у ObjectManager) */
QPushButton {
	background-color: rgba(0, 20, 0, 0.8);
	border: 2px solid #328844;
	color: #ffffff;
	font-size: 20px;
	padding: 8px 15px;
	border-radius: 4px;
}

QPushButton:hover {
	background-color: #328844;
	color: #000;
}

QPushButton:pressed {
	background-color: #4CAF50;
}

QPushButton:disabled {
	background-color: rgba(50, 50, 50, 0.5);
	border-color: #555;
	color: #888;
}

/* Кнопка скасування (червона) */
QPushButton#cancelButton {
	border-color: #aa3333;
}

QPushButton#cancelButton:hover {
	background-color: #aa3333;
}

/* Стилі полів вводу (SpinBox) */
QSpinBox, QDoubleSpinBox {
	background-color: rgba(0, 10, 0, 0.6);
	border: 1px solid #328844;
	color: #ffffff;
	font-size: 20px;
	padding: 5px;
	selection-background-color: #328844;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
	width: 25px;
	
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
	background-color: #328844;
}

/* Слайдер */
QSlider::groove:horizontal {
	border: 1px solid #328844;
	height: 8px;
	background: rgba(0, 10, 0, 0.6);
	margin: 2px 0;
	border-radius: 4px;
}

QSlider::handle:horizontal {
	background: #4CAF50;
	border: 1px solid #4CAF50;
	width: 18px;
	height: 18px;
	margin: -7px 0;
	border-radius: 9px;
}

QSlider::handle:horizontal:hover {
	background: #328844;
}
</string>
