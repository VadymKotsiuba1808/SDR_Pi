/* Кнопки */
QPushButton {
  border: none;
  background-color: rgba(0, 10, 0, 0.8);
  border: 1px solid #328844;
  color: #ffffff;
  font-size: 18px;
  padding: 6px;
  border-radius: 4px;
}
QPushButton:pressed {
  background-color: #328844;
  color: #002509;
}

QPushButton#btnLogout {
  border: none;
  background-color: rgba(40, 0, 0, 0.85);
  border: 1px solid #C0392B;
  color: #FFFFFF;
  font-size: 18px;
  padding: 6px;
  border-radius: 4px;
}

QPushButton#btnLogout:hover {
  background-color: rgba(80, 0, 0, 0.9);
}

QPushButton#btnLogout:pressed {
  background-color: #C0392B;
  color: #2B0000;
}

