  <property name="styleSheet">
   <string notr="true">QDialog {
  background-color: #002f00;
  color: #ffffff;
  font-family: 'Roboto';
  border: 2px solid #4CAF50;
  border-radius: 6px;
}

QLabel {
  color: #ffffff;
  font-size: 18px; 
  font-weight: 500;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
  background-color: rgba(0, 10, 0, 0.8);
  border: 1px solid #328844;
  color: #ffffff;
  padding: 6px; /* Збільшив padding для зручності */
  font-size: 18px;
  border-radius: 3px;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
  background-color: rgba(0, 0, 0, 0.6);  
  border: 1px solid #1a3a21;            
  color: #557766;                 
}

QComboBox::drop-down {}
QComboBox::down-arrow { width: 16px; height: 16px; }

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button, QSpinBox::up-button, QSpinBox::down-button {
    width: 20px; /* Трохи збільшив кнопки */
    padding: 2px;
}

QCheckBox {
    color: #ffffff;
    font-size: 18px;
    spacing: 10px;
}
QCheckBox::indicator {
    width: 20px; height: 20px;
    background-color: rgba(0, 10, 0, 0.8);
    border: 1px solid #328844;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background-color: #4CAF50;
    border: 1px solid #4CAF50;
    image: url();
}

/* Стиль для групи очистки */
QGroupBox {
    border: 1px solid #328844;
    border-radius: 5px;
    margin-top: 20px;
    font-size: 16px;
    color: #4CAF50;
    font-weight: bold;
    padding-top: 10px; /* Відступ всередині групи */
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px;
}

QPushButton {
  border: none;
  background-color: rgba(0, 10, 0, 0.8);
  border: 1px solid #328844;
  color: #ffffff;
  font-size: 18px;
  padding: 8px 16px; /* Збільшив кнопку */
  border-radius: 4px;
}
QPushButton:pressed { background-color: #328844; color: #002509; }

QPushButton#btnLogout {
  border: none;
  background-color: rgba(40, 0, 0, 0.85);
  border: 1px solid #C0392B;
  color: #FFFFFF;
}
QPushButton#btnLogout:hover { background-color: rgba(80, 0, 0, 0.9); }
QPushButton#btnLogout:pressed { background-color: #C0392B; color: #2B0000; }
</string>
