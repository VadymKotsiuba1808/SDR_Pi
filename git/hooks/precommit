#!/bin/bash

# 1. Запускаємо локальну перевірку (Ruff + Mypy)
echo "🔍 Running code quality checks (Ruff & Mypy)..."
make check

# Перевіряємо статус виконання команди make check
if [ $? -ne 0 ]; then
    echo "❌ Code quality checks failed!"
    echo "🤖 Triggering Gemini CLI to automatically fix strict typing and linting issues..."
    
    # Викликаємо Gemini чіткою англійською командою для виправлення змінених файлів
    gemini run "Fix all strict typing (Mypy) and linting (Ruff) errors in the currently staged git files."
    
    echo "------------------------------------------------------------------------"
    echo "💡 Gemini has processed the files. Please review the changes using 'git diff',"
    echo "   re-add them via 'git add', and try to commit again."
    echo "------------------------------------------------------------------------"
    
    # Блокуємо коміт, щоб ти міг перевірити, що саме виправив ШІ
    exit 1
fi

echo "✅ All checks passed! Proceeding with commit..."